# /etc/viralfactory/env
# Create this file on the VPS (NOT committed to repo — holds secrets).
# Use `sudoedit /etc/viralfactory/env`; never put actual values in Git,
# shell history, or chat. The services load this file through EnvironmentFile=.
OLLAMA_API_KEY=your_api_key_here
# Optional music discovery (both required for Bundle Social):
BUNDLE_SOCIAL_API_KEY=your_bundle_social_api_key_here
BUNDLE_TEAM_ID=your_bundle_team_id_here